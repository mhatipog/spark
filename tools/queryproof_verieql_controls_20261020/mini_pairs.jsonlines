{"name":"S1_non_equiv_literal","index":0,"schema":{"T":{"K":"INT","V":"INT"}},"constraint":null,"pair":["SELECT 1 AS X FROM T","SELECT 2 AS X FROM T"]}
{"name":"S2_identity_projection","index":1,"schema":{"T":{"K":"INT","V":"INT"}},"constraint":null,"pair":["SELECT K AS X FROM T","SELECT Q.X FROM (SELECT K AS X FROM T) Q"]}
{"name":"S3_repeat_group_key","index":2,"schema":{"T":{"K":"INT","V":"INT"}},"constraint":null,"pair":["SELECT K, COUNT(*) AS N FROM T GROUP BY K,K","SELECT K, COUNT(*) AS N FROM T GROUP BY K"]}
{"name":"S4_left_or_dependency_frame","index":3,"schema":{"L":{"I":"INT","J":"INT","EXTRA":"INT"},"R":{"I":"INT","J":"INT","EXTRA":"INT"}},"constraint":null,"pair":["SELECT L.I, COUNT(R.J) AS N FROM L LEFT JOIN R ON L.I = R.I OR L.J = R.J GROUP BY L.I","SELECT LP.I, COUNT(RP.J) AS N FROM (SELECT I, J FROM L) LP LEFT JOIN (SELECT I, J FROM R) RP ON LP.I = RP.I OR LP.J = RP.J GROUP BY LP.I"]}
{"name":"S5_left_or_wrong_guard","index":4,"schema":{"L":{"I":"INT","J":"INT","EXTRA":"INT"},"R":{"I":"INT","J":"INT","EXTRA":"INT"}},"constraint":null,"pair":["SELECT L.I, COUNT(R.J) AS N FROM L LEFT JOIN R ON L.I = R.I OR L.J = R.J GROUP BY L.I","SELECT L.I, COUNT(RP.J) AS N FROM L LEFT JOIN (SELECT I, J FROM R WHERE I IS NOT NULL) RP ON L.I = RP.I OR L.J = RP.J GROUP BY L.I"]}
